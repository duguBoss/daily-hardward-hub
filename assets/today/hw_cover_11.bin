#include <SPI.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SH110X.h> 
#include <EEPROM.h> // 💾 Added for permanent data saving

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1 

Adafruit_SH1106G display = Adafruit_SH1106G(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

const int BUTTON_A = 2; // Feed / Left / Menu Scroll
const int BUTTON_B = 3; // Play / Menu Select
const int BUTTON_C = 4; // Stats / Right

unsigned long lastDebounceTime = 0;
const unsigned long DEBOUNCE_DELAY = 50; 

// --- 👁️ BLINKING VARIABLES ---
unsigned long lastBlinkTime = 0;
unsigned long blinkInterval = 3000; 
bool isBlinking = false;
const unsigned long BLINK_DURATION = 200;  

// --- 💤 SLEEP & INACTIVITY VARIABLES ---
unsigned long lastActivityTime = 0;
const unsigned long INACTIVITY_TIMEOUT = 15000; 
int zAnimOffset = 0; 
unsigned long lastZAnimTime = 0;

// --- STATE MANAGEMENT ---
// 0=Normal, 1=Eating, 2=Playing, 3=Stats, 4=FeedPlayCombo, 5=Asleep, 6=SecretMenu, 7=MiniGame, 8=ErrorScreen, 9=MutationMenu, 10=Dead
int petState = 0; 
unsigned long stateResetTime = 0;
unsigned long stateDuration = 2500; 

// --- ACTION SUB-TYPES ---
int selectedFood = 0; 
int selectedPlayAction = 0; 
int selectedComboAction = 0; 
int selectedJoke = 0;        
int menuChoice = 0;          
int currentMutation = 0;     
int mutationChoice = 0;      

// --- 🎮 MINI-GAME SYSTEM VARIABLES ---
int targetSide = 0;          
unsigned long targetSpawnTime = 0;
int miniGameScore = 0;
bool miniGameActive = false;

// --- 🍔 ANIMATION TRACKERS ---
int foodX = 96;             
unsigned long lastAnimFrameTime = 0;
int animFrame = 0;          
int ballX = 10;
int ballY = 40;
int ballDirX = 2;
int ballDirY = -1;

// --- ⏳ DEATH COUNTDOWN TRACKERS ---
int deathTimerSeconds = 100;
unsigned long lastDeathTickTime = 0;

// --- 🛠️ DEFAULT CORE GAME STATS ---
int hungerPercent = 30;
int happyPercent = 30;
int sleepPercent = 30;
long bitcoinCount = 10; 

// --- 💾 EEPROM SAVE ADDRESS SLOTS ---
const int ADDR_HUNGER   = 10;
const int ADDR_HAPPY    = 11;
const int ADDR_SLEEP    = 12;
const int ADDR_MUTATION = 13;
const int ADDR_BITCOIN  = 14; // Uses 4 bytes since it is a long variable
const int ADDR_IS_SAVED = 99; // Check flag to see if memory is empty

void setup() {
  Serial.begin(9600);
  
  pinMode(BUTTON_A, INPUT_PULLUP);
  pinMode(BUTTON_B, INPUT_PULLUP);
  pinMode(BUTTON_C, INPUT_PULLUP);
  
  if(!display.begin(0x3C, true)) {
    Serial.println(F("SH1106 allocation failed!"));
    for(;;); 
  }
  
  display.clearDisplay();
  randomSeed(analogRead(0)); 

  // 💾 LOAD PREVIOUS GAME DATA IF IT EXISTS
  if (EEPROM.read(ADDR_IS_SAVED) == 77) {
    hungerPercent = EEPROM.read(ADDR_HUNGER);
    happyPercent  = EEPROM.read(ADDR_HAPPY);
    sleepPercent  = EEPROM.read(ADDR_SLEEP);
    currentMutation = EEPROM.read(ADDR_MUTATION);
    EEPROM.get(ADDR_BITCOIN, bitcoinCount);
  } else {
    saveGameData(); // Write defaults on very first boot up
  }
}

void loop() {
  unsigned long currentMillis = millis();

  // --- 💀 CRITICAL DEATH SYSTEM CHECK ---
  if (hungerPercent >= 100) {
    if (petState != 10) { // If countdown just activated
      if (currentMillis - lastDeathTickTime >= 1000) {
        lastDeathTickTime = currentMillis;
        deathTimerSeconds--;
        
        if (deathTimerSeconds <= 0) {
          petState = 10; // Trigger Permanent Death
          eraseGameData(); // Clear EEPROM Save
        }
      }
    }
  } else {
    deathTimerSeconds = 100; // Reset count safely if lowered below 100%
  }

  // Freeze process loop if character is dead
  if (petState == 10) {
    drawScreen();
    return;
  }

  // --- 1. HANDLE AUTOMATIC SLEEP & RECHARGING BC ---
  if (petState == 0 || petState == 5) {
    if (currentMillis - lastActivityTime >= INACTIVITY_TIMEOUT) {
      petState = 5; 
      if (sleepPercent < 100 && (currentMillis - lastZAnimTime >= 1000)) {
        sleepPercent++; 
        bitcoinCount++; 
        lastZAnimTime = currentMillis;
        saveGameData(); // Auto-save backgrounds tasks
      }
    } else {
      if (petState == 5) petState = 0; 
    }
  }

  // --- 2. HANDLE BLINKING ---
  if (petState == 0) { 
    if (!isBlinking && (currentMillis - lastBlinkTime >= blinkInterval)) {
      isBlinking = true;
      lastBlinkTime = currentMillis;
      blinkInterval = random(2000, 6000); 
    }
    if (isBlinking && (currentMillis - lastBlinkTime >= BLINK_DURATION)) {
      isBlinking = false;
    }
  }

  // --- 3. STATE TIMER CLEANUP ---
  if (petState != 0 && petState != 5 && petState != 6 && petState != 7 && petState != 9) {
    if (currentMillis - stateResetTime > stateDuration) { 
      petState = 0; 
    }
  }

  // Animations clocks
  if (petState == 5 && (currentMillis - lastZAnimTime >= 400)) zAnimOffset = (zAnimOffset + 2) % 12;
  if (petState == 1 && (currentMillis - lastAnimFrameTime >= 60)) {
    lastAnimFrameTime = currentMillis;
    if (foodX > 56) foodX -= 2; 
  }
  if (petState == 2 && (currentMillis - lastAnimFrameTime >= 40)) {
    lastAnimFrameTime = currentMillis;
    animFrame++; 
  }

  if (petState == 7 && miniGameActive) {
    if (currentMillis - targetSpawnTime > 1200) { 
      targetSide = random(0, 2);
      targetSpawnTime = currentMillis;
    }
  }

  // --- 5. CHECK BUTTON INPUTS ---
  if ((currentMillis - lastDebounceTime) > DEBOUNCE_DELAY) {
    bool pressedA = (digitalRead(BUTTON_A) == LOW);
    bool pressedB = (digitalRead(BUTTON_B) == LOW);
    bool pressedC = (digitalRead(BUTTON_C) == LOW);

    if (pressedA || pressedB || pressedC) {
      if (petState != 6 && petState != 7 && petState != 9) lastActivityTime = currentMillis; 
    }

    if (petState == 6) {
      if (pressedA) { menuChoice = (menuChoice + 1) % 2; delay(150); lastDebounceTime = currentMillis; }
      else if (pressedB) { 
        if (menuChoice == 0) {
          petState = 7; miniGameScore = 0; miniGameActive = true; targetSide = random(0, 2); targetSpawnTime = currentMillis;
        } else {
          petState = 9; mutationChoice = currentMutation;
        }
        delay(150); lastDebounceTime = currentMillis;
      }
    }
    else if (petState == 9) {
      if (pressedA) { mutationChoice = (mutationChoice + 1) % 4; delay(150); lastDebounceTime = currentMillis; }
      else if (pressedB) { currentMutation = mutationChoice; petState = 0; saveGameData(); delay(150); lastDebounceTime = currentMillis; }
    }
    else if (petState == 7) {
      if (pressedA && targetSide == 0) { bitcoinCount += 5; miniGameScore++; targetSide = random(0, 2); targetSpawnTime = currentMillis; saveGameData(); lastDebounceTime = currentMillis; }
      else if (pressedC && targetSide == 1) { bitcoinCount += 5; miniGameScore++; targetSide = random(0, 2); targetSpawnTime = currentMillis; saveGameData(); lastDebounceTime = currentMillis; }
      if (miniGameScore >= 3) { petState = 0; miniGameActive = false; }
    }
    else {
      if (pressedA && pressedB) { triggerFeedPlayCombo(); saveGameData(); lastDebounceTime = currentMillis; } 
      else if (pressedC && pressedB) { petState = 6; menuChoice = 0; delay(200); lastDebounceTime = currentMillis; }
      else if (pressedA && (petState == 0 || petState == 5)) {
        if (bitcoinCount >= 5) { bitcoinCount -= 5; feedPet(); saveGameData(); } 
        else { triggerNoFundsError(); }
        lastDebounceTime = currentMillis;
      } 
      else if (pressedB && (petState == 0 || petState == 5)) {
        if (bitcoinCount >= 5) { bitcoinCount -= 5; playPet(); saveGameData(); } 
        else { triggerNoFundsError(); }
        lastDebounceTime = currentMillis;
      } 
      else if (pressedC && (petState == 0 || petState == 5)) { checkStats(); lastDebounceTime = currentMillis; }
    }
  }

  drawScreen();
}

// --- 💾 EEPROM CONTROLLERS ---
void saveGameData() {
  EEPROM.update(ADDR_HUNGER, hungerPercent);
  EEPROM.update(ADDR_HAPPY, happyPercent);
  EEPROM.update(ADDR_SLEEP, sleepPercent);
  EEPROM.update(ADDR_MUTATION, currentMutation);
  EEPROM.put(ADDR_BITCOIN, bitcoinCount);
  EEPROM.update(ADDR_IS_SAVED, 77); // Confirms clear save template exists
}

void eraseGameData() {
  EEPROM.update(ADDR_IS_SAVED, 0); // Invalidates save file path
}

void drawPetShell(int x, int y, int size, bool openMouth) {
  if (currentMutation == 0)      display.drawRect(x, y, size, size, SH110X_WHITE);
  else if (currentMutation == 1) display.drawTriangle(x + (size/2), y, x, y + size, x + size, y + size, SH110X_WHITE);
  else if (currentMutation == 2) display.drawRoundRect(x, y + 8, size, size - 8, 8, SH110X_WHITE);
  else {
    display.drawRoundRect(x, y, size, size - 6, 6, SH110X_WHITE);
    for (int i = 0; i < size; i += 6) display.drawFastVLine(x + i, y + size - 6, 4 + (i % 3), SH110X_WHITE);
  }
}

void drawPreviewShell(int mutationIndex, int x, int y, int size) {
  if (mutationIndex == 0)      display.drawRect(x, y, size, size, SH110X_WHITE);
  else if (mutationIndex == 1) display.drawTriangle(x + (size/2), y, x, y + size, x + size, y + size, SH110X_WHITE);
  else if (mutationIndex == 2) display.drawRoundRect(x, y + 4, size, size - 4, 4, SH110X_WHITE);
  else {
    display.drawRoundRect(x, y, size, size - 3, 3, SH110X_WHITE);
    for (int i = 0; i < size; i += 4) display.drawFastVLine(x + i, y + size - 3, 2, SH110X_WHITE);
  }
}

void drawScreen() {
  display.clearDisplay();
  display.setTextColor(SH110X_WHITE);
  display.setTextSize(1);
  
  int bodyX = 44; int bodyY = 12; int bodySize = 40;

  // 💀 DRAW DEAD SCREEN STATE IF GAME OVER ACCRUED
  if (petState == 10) {
    display.setTextSize(2);   display.setCursor(10, 10); display.print(F("GAME OVER"));
    display.setTextSize(1);   display.setCursor(20, 36); display.print(F("Pet Starved to Death"));
    display.setCursor(15, 50); display.print(F("Data Has Been Reset"));
    display.display();
    return;
  }

  if (petState != 3 && petState != 4 && petState != 6 && petState != 7 && petState != 8 && petState != 9) {
    drawPetShell(bodyX, bodyY, bodySize, (petState == 1));
  }

  if (petState == 0) { 
    if (isBlinking) {
      display.drawFastHLine(bodyX + 8,  bodyY + 14, 6, SH110X_WHITE);
      display.drawFastHLine(bodyX + 26, bodyY + 14, 6, SH110X_WHITE);
    } else {
      display.fillRect(bodyX + 8,  bodyY + 10, 6, 6, SH110X_WHITE);
      display.fillRect(bodyX + 26, bodyY + 10, 6, 6, SH110X_WHITE);
    }
    display.drawFastHLine(bodyX + 16, bodyY + 26, 8, SH110X_WHITE);
    
    // 🔥 EMERGENCY COUNTDOWN TEXT DISPLAY INTERACTIVE WINDOW
    if (hungerPercent >= 100) {
      display.setCursor(2, 54);
      display.print(F("STARVING! DIE IN:")); display.print(deathTimerSeconds); display.print(F("s"));
    } else if (hungerPercent >= 90) {
      display.setCursor(15, 56); display.print(F("HIGH HUNGER! ")); display.print(hungerPercent); display.print(F("%"));
    }
  } 
  
  else if (petState == 1) { 
    display.drawFastHLine(bodyX + 8,  bodyY + 13, 6, SH110X_WHITE);
    display.drawFastHLine(bodyX + 26, bodyY + 13, 6, SH110X_WHITE);
    if (foodX % 4 == 0 && foodX <= 58) display.drawFastHLine(bodyX + 14, bodyY + 24, 12, SH110X_WHITE); 
    else display.fillRect(bodyX + 14, bodyY + 20, 12, 10, SH110X_WHITE);  
    
    if (foodX > 54) {
      if (selectedFood == 0) { 
        display.fillRoundRect(foodX, bodyY + 18, 16, 6, 2, SH110X_WHITE); display.drawFastHLine(foodX - 1, bodyY + 25, 18, SH110X_WHITE); display.fillRect(foodX, bodyY + 27, 16, 4, SH110X_WHITE);         
      } else if (selectedFood == 1) { 
        display.drawCircle(foodX + 6, bodyY + 22, 8, SH110X_WHITE); display.fillRect(foodX - 4, bodyY + 10, 12, 24, SH110X_BLACK); 
      } else { 
        display.fillTriangle(foodX, bodyY + 24, foodX + 12, bodyY + 24, foodX + 6, bodyY + 36, SH110X_WHITE); display.fillCircle(foodX + 6, bodyY + 20, 5, SH110X_WHITE);                 
      }
    } else {
      display.setCursor(bodyX + 11, bodyY + 22); display.setTextColor(SH110X_BLACK); display.print(F("yum")); display.setTextColor(SH110X_WHITE);
    }
  } 
  
  else if (petState == 2) { 
    if (selectedPlayAction == 0) { 
      int angleFrame = (animFrame / 4) % 4; display.setCursor(5, 5); display.print(F("CARTWHEEL!"));
      if (angleFrame == 0 || angleFrame == 2) { display.fillRect(bodyX + 8,  bodyY + 10, 6, 6, SH110X_WHITE); display.fillRect(bodyX + 26, bodyY + 10, 6, 6, SH110X_WHITE); display.drawFastHLine(bodyX + 15, bodyY + 26, 10, SH110X_WHITE); } 
      else if (angleFrame == 1) { display.fillRect(bodyX + 22, bodyY + 14, 4, 4, SH110X_WHITE); } 
      else { display.fillRect(bodyX + 8,  bodyY + 26, 6, 6, SH110X_WHITE); display.fillRect(bodyX + 26, bodyY + 26, 6, 6, SH110X_WHITE); }
    } else if (selectedPlayAction == 1) { 
      int jumpHeight = abs(sin((animFrame * 0.15)) * 14); display.setCursor(5, 5); display.print(F("BOING!")); display.clearDisplay();
      drawPetShell(bodyX, bodyY - jumpHeight, bodySize, false); display.fillRect(bodyX + 8,  bodyY - jumpHeight + 10, 6, 6, SH110X_WHITE); display.fillRect(bodyX + 26, bodyY - jumpHeight + 10, 6, 6, SH110X_WHITE); display.drawFastHLine(bodyX + 15, bodyY - jumpHeight + 25, 10, SH110X_WHITE);
    } else { 
      display.fillRect(bodyX + 8,  bodyY + 12, 6, 6, SH110X_WHITE); display.fillRect(bodyX + 26, bodyY + 12, 6, 6, SH110X_WHITE);
      ballX += ballDirX; ballY += ballDirY; if (ballX <= 2 || ballX >= 122) ballDirX *= -1; if (ballY <= 5 || ballY >= 58)  ballDirY *= -1;
      if (ballX < bodyX) display.drawFastHLine(bodyX + 13, bodyY + 26, 6, SH110X_WHITE); else display.drawRect(bodyX + 15, bodyY + 24, 10, 5, SH110X_WHITE); 
      display.fillCircle(ballX, ballY, 3, SH110X_WHITE); 
    }
  } 
  
  else if (petState == 3) { 
    display.setCursor(0, 0);   display.print(F("--- PET STATUS ---"));
    display.setCursor(0, 14);  display.print(F("HUNGER: ")); display.print(hungerPercent); display.print(F("%"));
    display.setCursor(0, 26);  display.print(F("HAPPY:  ")); display.print(happyPercent); display.print(F("%"));
    display.setCursor(0, 38);  display.print(F("SLEEP:  ")); display.print(sleepPercent); display.print(F("%"));
    display.setCursor(0, 52);  display.print(F("BC:     ")); display.print(bitcoinCount); display.print(F(" coins"));
  }
  
  else if (petState == 4) { 
    if (selectedComboAction == 0) { 
      display.setCursor(20, 5); display.print(F("SUPER COMBO")); display.setTextSize(2); display.setCursor(35, 20); display.print(F("Glow!")); display.setTextSize(1); display.setCursor(5, 42); display.print(F("Stats Boosted +10%!")); display.setCursor(5, 54); display.print(F("Earned +10 Bitcoin!"));
    } else { 
      display.setCursor(0, 0); display.print(F("[Pet Tells A Joke!]:")); display.setCursor(0, 18);
      if (selectedJoke == 0) { display.print(F("What is a wizard's\nfavorite computer\nprogram?")); display.setCursor(0, 54); display.print(F("A: The Wi-Zard!")); } 
      else if (selectedJoke == 1) { display.print(F("Why did the computer\ngo to the hospital?")); display.setCursor(0, 54); display.print(F("A: Had a bad virus!")); } 
      else { display.print(F("How do pixels say\ngoodbye to friends?")); display.setCursor(0, 54); display.print(F("A: They screen-shot!")); }
    }
  }
  
  else if (petState == 5) { 
    display.drawFastHLine(bodyX + 8,  bodyY + 14, 6, SH110X_WHITE); display.drawFastHLine(bodyX + 26, bodyY + 14, 6, SH110X_WHITE); display.drawCircle(bodyX + 20, bodyY + 26, 4, SH110X_WHITE);
    display.setCursor(bodyX + 45, bodyY - zAnimOffset); display.print(F("z")); display.setCursor(bodyX + 53, bodyY - 6 - zAnimOffset); display.print(F("Z"));
    
    if (hungerPercent >= 100) {
      display.setCursor(2, 54); display.print(F("STARVING! DIE IN:")); display.print(deathTimerSeconds); display.print(F("s"));
    } else if (hungerPercent >= 90) {
      display.setCursor(15, 56); display.print(F("HIGH HUNGER! ")); display.print(hungerPercent); display.print(F("%"));
    }
  }
  
  else if (petState == 6) { 
    display.setCursor(15, 5); display.print(F("== SECRET MENU ==")); display.setCursor(20, 24); display.print(F("PLAY MINI-GAME")); display.setCursor(20, 42); display.print(F("MUTATE DNA SHELL"));
    int arrowY = (menuChoice == 0) ? 24 : 42; display.setCursor(5, arrowY); display.print(F(">"));
  }
  
  else if (petState == 7) { 
    display.setCursor(30, 2); display.print(F("Score: ")); display.print(miniGameScore); display.print(F("/3"));
    if (targetSide == 0) { display.drawRect(5, 24, 20, 20, SH110X_WHITE); display.setCursor(8, 30); display.print(F("HIT")); } 
    else { display.drawRect(103, 24, 20, 20, SH110X_WHITE); display.setCursor(106, 30); display.print(F("HIT")); }
    drawPetShell(48, 20, 24, false);
  }
  
  else if (petState == 8) { 
    display.setTextSize(2);   display.setCursor(15, 12); display.print(F("ERROR!")); display.setTextSize(1);   display.setCursor(15, 38); display.print(F("Not enough BC"));
  }

  else if (petState == 9) { 
    display.setCursor(10, 2); display.print(F("== SELECT SHELL ==")); display.setCursor(20, 16); display.print(F("SQUARE")); display.setCursor(20, 28); display.print(F("TRIANGLE")); display.setCursor(20, 40); display.print(F("SLIME")); display.setCursor(20, 52); display.print(F("GHOST"));
    int arrowY = 16 + (mutationChoice * 12); display.setCursor(8, arrowY); display.print(F(">")); display.drawRect(92, 18, 28, 28, SH110X_WHITE);
    drawPreviewShell(mutationChoice, 96, 22, 20);
  }

  display.display(); 
}

void triggerNoFundsError() { petState = 8; stateDuration = 2000; stateResetTime = millis(); }

void feedPet() {
  petState = 1; stateDuration = 2500; foodX = 96; selectedFood = random(0, 3); stateResetTime = millis();
  if (hungerPercent > 0) hungerPercent -= 10; if (sleepPercent > 5) sleepPercent -= 5;    
}

void playPet() {
  petState = 2; animFrame = 0; lastAnimFrameTime = millis(); stateResetTime = millis(); selectedPlayAction = random(0, 3); 
  if (selectedPlayAction == 2) { stateDuration = 5000; ballX = 15; ballY = 20; } else { stateDuration = 2500; }
  if (happyPercent < 100) happyPercent += 15; if (hungerPercent < 100) hungerPercent += 10; if (sleepPercent > 12) sleepPercent -= 12;   
}

void checkStats() { petState = 3; stateDuration = 4000; stateResetTime = millis(); }

void triggerFeedPlayCombo() {
  petState = 4; stateDuration = 6000; stateResetTime = millis(); selectedComboAction = random(0, 2); 
  if (selectedComboAction == 0) {
    bitcoinCount += 10; hungerPercent -= 10; happyPercent += 10; sleepPercent += 10;
    if (hungerPercent < 0) hungerPercent = 0; if (happyPercent > 100) happyPercent = 100; if (sleepPercent > 100) sleepPercent = 100;
  } else { selectedJoke = random(0, 3); }
  while(digitalRead(BUTTON_A) == LOW || digitalRead(BUTTON_B) == LOW) { delay(10); }
}
