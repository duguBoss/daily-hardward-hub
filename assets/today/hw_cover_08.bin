#include <Adafruit_NeoPixel.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define TRIG A0
#define ECHO 13

// Motor 1
#define M1A 9
#define M1B 8

// Motor 2
#define M2A 6
#define M2B 7

// WS2812B
#define LED_PIN 11
#define NUM_LEDS 1

Adafruit_NeoPixel led(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);

// OLED
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  OLED_RESET
);


// ---------- Ultrasonic ----------
long getDistance() {

  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);

  long duration = pulseIn(ECHO, HIGH, 30000);

  if (duration == 0) return 999;

  return duration * 0.034 / 2;
}


// ---------- OLED ----------
void showStatus(String status) {

  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(2);

  display.setCursor(10, 20);

  display.println(status);

  display.display();
}


// ---------- LED ----------
void green() {

  led.setPixelColor(0, led.Color(0, 255, 0));
  led.show();
}


void red() {

  led.setPixelColor(0, led.Color(255, 0, 0));
  led.show();
}


// ---------- Motors ----------
void forward() {

  green();
  showStatus("FORWARD");

  digitalWrite(M1A, LOW);
  digitalWrite(M1B, HIGH);

  digitalWrite(M2A, LOW);
  digitalWrite(M2B, HIGH);
}


void backward() {

  green();
  showStatus("BACKWARD");

  digitalWrite(M1A, HIGH);
  digitalWrite(M1B, LOW);

  digitalWrite(M2A, HIGH);
  digitalWrite(M2B, LOW);
}


void rotateRight() {

  green();
  showStatus("RIGHT");

  digitalWrite(M1A, LOW);
  digitalWrite(M1B, HIGH);

  digitalWrite(M2A, HIGH);
  digitalWrite(M2B, LOW);
}


void stopMotors() {

  red();
  showStatus("STOP");

  digitalWrite(M1A, LOW);
  digitalWrite(M1B, LOW);

  digitalWrite(M2A, LOW);
  digitalWrite(M2B, LOW);
}


// ---------- Setup ----------
void setup() {

  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);

  pinMode(M1A, OUTPUT);
  pinMode(M1B, OUTPUT);

  pinMode(M2A, OUTPUT);
  pinMode(M2B, OUTPUT);

  led.begin();
  led.setBrightness(50);

  Serial.begin(9600);

  // OLED start
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    while (true);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(2);
  display.setCursor(20, 20);
  display.println("START");
  display.display();

  delay(1000);

  stopMotors();
}


// ---------- Main ----------
void loop() {

  long distance = getDistance();

  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" cm");


  // =====================================
  // SPACE AVAILABLE
  // =====================================

  if (distance >= 30) {

    // Go forward for 1 second
    forward();
    delay(1000);

    // Stop
    stopMotors();
    delay(300);
  }


  // =====================================
  // NO SPACE
  // =====================================

  else {

    Serial.println("NO SPACE!");

    // Stop
    stopMotors();
    delay(300);

    // Reverse for 2 seconds
    Serial.println("BACKWARD");

    backward();
    delay(2000);

    // Stop
    stopMotors();
    delay(300);

    // Rotate right for 0.2 seconds
    Serial.println("ROTATE RIGHT");

    rotateRight();
    delay(200);

    // Stop for 4 seconds
    Serial.println("WAIT");

    stopMotors();
    delay(4000);
  }
}this is i mke and make a pich for the connection arroding the code