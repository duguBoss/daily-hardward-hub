#include <LiquidCrystal.h>

#define LDR_ANALOG A5
#define LDR_DIGITAL 9

// LCD: RS=A4, EN=A3, D4=A2, D5=A1, D6=A0, D7=D13
LiquidCrystal lcd(A4, A3, A2, A1, A0, 13);

void setup() {

  pinMode(LDR_DIGITAL, INPUT);

  Serial.begin(9600);

  lcd.begin(16, 2);
  lcd.clear();
}

void loop() {

  int analogValue = analogRead(LDR_ANALOG);
  int digitalValue = digitalRead(LDR_DIGITAL);

  // Serial Monitor
  Serial.print("Analog: ");
  Serial.print(analogValue);
  Serial.print(" | Digital: ");
  Serial.println(digitalValue);

  // LCD
  lcd.setCursor(0, 0);

  if (digitalValue == HIGH) {
    lcd.print(" DETECTED      ");
  } 
  else {
    lcd.print(" NO DETECTION  ");
  }

  // Show readings on second line
 // lcd.setCursor();
  //lcd.print("A:");
 // lcd.print(analogValue);
 // lcd.print(" D:");
 // lcd.print(digitalValue);
  lcd.print("       ");

  delay(200);
}